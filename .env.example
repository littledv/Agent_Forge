# Safe local-development placeholders only. Copy to .env if customization is
# needed; never put real credentials in this file.
POSTGRESQL_VERSION=16.15
POSTGRES_USER=temporal
POSTGRES_PASSWORD=temporal-local-only
TEMPORAL_VERSION=1.32.1
TEMPORAL_ADMINTOOLS_VERSION=1.32.1
TEMPORAL_UI_VERSION=2.54.1

AGENTFORGE_DATABASE_URL=postgresql+psycopg://temporal:temporal-local-only@127.0.0.1:5432/agentforge
AGENTFORGE_TEST_DATABASE_URL=postgresql+psycopg://temporal:temporal-local-only@127.0.0.1:5432/agentforge_test
AGENTFORGE_TEMPORAL_ADDRESS=127.0.0.1:7233
AGENTFORGE_TEMPORAL_NAMESPACE=default
AGENTFORGE_TEMPORAL_TASK_QUEUE=agentforge-support-report-v1
AGENTFORGE_TICKET_ROOT=samples/tickets
AGENTFORGE_ARTIFACT_ROOT=artifacts
AGENTFORGE_MAX_DECISIONS=4
AGENTFORGE_MAX_TICKET_BYTES=65536
AGENTFORGE_MAX_TOTAL_TICKET_BYTES=262144
AGENTFORGE_INBOX_BASE_URL=http://127.0.0.1:8001
AGENTFORGE_INBOX_DATABASE_URL=postgresql+psycopg://temporal:temporal-local-only@127.0.0.1:5432/agentforge_inbox
AGENTFORGE_APPROVAL_TTL_SECONDS=300
AGENTFORGE_ENABLED_MODEL_PROFILES=mock-v1
AGENTFORGE_WORKER_MODEL_PROFILE=mock-v1
AGENTFORGE_OLLAMA_BASE_URL=http://127.0.0.1:11434
AGENTFORGE_OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Required only when the Ollama profile is enabled. Use the full verified digest.
AGENTFORGE_OLLAMA_MODEL_DIGEST=
AGENTFORGE_MODEL_CONTEXT_TOKENS=8192
AGENTFORGE_MODEL_MAX_OUTPUT_TOKENS=2048
AGENTFORGE_MODEL_MAX_PROMPT_CHARS=24000
AGENTFORGE_MODEL_MAX_REPORT_CHARS=16384
AGENTFORGE_MODEL_MAX_REPAIRS=2
AGENTFORGE_MODEL_TIMEOUT_SECONDS=150
